# ─── Base de datos ────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://usuario:contraseña@localhost:5432/asistente_uni

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Generá un valor seguro con: openssl rand -hex 32
SECRET_KEY=cambia_esto_por_un_secreto_seguro
ALGORITHM=HS256
# Tiempo de expiración del token en minutos
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ─── IA / OpenRouter ──────────────────────────────────────────────────────────
# API key en: https://openrouter.ai/keys — los modelos ":free" no tienen costo
# pero tienen límite diario y pueden desaparecer: verificá que sigan existiendo.
OPENROUTER_API_KEY=sk-or-...
AI_MODEL=qwen/qwen3.8-27b:free
# Modelos alternativos si AI_MODEL falla (lista JSON, en orden)
AI_MODELOS_RESPALDO=["qwen/qwen3.8-27b:free","google/gemma-4-26b-a4b-it:free"]
# Proveedores gratuitos de respaldo si OpenRouter se queda sin cupo ("proveedor|modelo").
# Sin key se saltean. Keys gratis: https://console.groq.com · https://aistudio.google.com/apikey
GROQ_API_KEY=
GEMINI_API_KEY=
AI_PROVEEDORES=[]
# Horas que una respuesta queda en caché (se invalida sola si cambian los datos)
CACHE_TTL_HORAS=6
# Clasificación con LLM cuando ninguna regla coincide: tope por corrida (0 = nunca)
CLASIFICACION_LLM_MAX_POR_CORRIDA=0
SITE_URL=https://utnia.netlify.app
SITE_NAME=Asistente UTN

# ─── Usuarios ─────────────────────────────────────────────────────────────────
# Dominios de correo con los que se pueden crear cuentas y loguearse (lista JSON)
DOMINIOS_PERMITIDOS=["alu.frt.utn.edu.ar"]

# ─── WhatsApp (Cloud API oficial, reenvíos de posteos al número del bot) ──────
# Ver docs/ACTUALIZACIONES.md. Sin WHATSAPP_APP_SECRET el webhook queda apagado.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# Números autorizados a reenviar, solo dígitos con código de país (lista JSON)
WHATSAPP_REENVIADORES=[]
# Fuente donde se guardan (vacío = la primera fuente de WhatsApp)
WHATSAPP_FUENTE=

# ─── Rate limiting ────────────────────────────────────────────────────────────
# Mensajes máximos por usuario por minuto en el chat (se cuenta en Postgres)
CHAT_MAX_POR_MINUTO=10

# ─── Entorno ──────────────────────────────────────────────────────────────────
# Valores posibles: development | production
ENVIRONMENT=development

# ─── CORS (origins permitidos, separados por coma) ────────────────────────────
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
