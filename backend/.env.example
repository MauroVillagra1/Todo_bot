# ─── Base de datos ────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://usuario:contraseña@localhost:5432/asistente_uni

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Generá un valor seguro con: openssl rand -hex 32
SECRET_KEY=cambia_esto_por_un_secreto_seguro
ALGORITHM=HS256
# Tiempo de expiración del token en minutos
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ─── IA / Groq (gratuito) ─────────────────────────────────────────────────────
# Obtené tu API key gratis en: https://console.groq.com
GROQ_API_KEY=gsk_...
GROQ_MODEL=llama-3.1-8b-instant

# ─── Rate limiting ────────────────────────────────────────────────────────────
# Peticiones máximas por minuto por IP para el endpoint del chat
RATE_LIMIT_CHAT=20/minute

# ─── Entorno ──────────────────────────────────────────────────────────────────
# Valores posibles: development | production
ENVIRONMENT=development

# ─── CORS (origins permitidos, separados por coma) ────────────────────────────
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
